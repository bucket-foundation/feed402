  "operations": [
    {
      "operation_id": "raw.fetch",
      "capability": "fetch",
      "path": "/raw",
      "method": "POST",
      "tier": "raw",
      "description": "Fetch one record by identifier.",
      "input_schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "output_schema": "https://example.org/schema/record.json",
      "pagination_model": "none",
      "identifier_schemes": [
        "example-record-id"
      ],
      "canonical_identifier": "example-record-id",
      "content_types": [
        "application/json"
      ]
    },
    {
      "operation_id": "query.search",
      "capability": "search",
      "path": "/query",
      "method": "POST",
      "tier": "query",
      "description": "Keyword search with offset pagination.",
      "input_schema": {
        "type": "object",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "pagination_model": "offset",
      "identifier_schemes": [
        "example-record-id"
      ],
      "canonical_identifier": "example-record-id",
      "content_types": [
        "application/json"
      ]
    },
    {
      "operation_id": "insight.semantic",
      "capability": "semantic_search",
      "path": "/insight",
      "method": "POST",
      "tier": "insight",
      "description": "Dense retrieval over the indexed corpus.",
      "pagination_model": "none",
      "content_types": [
        "application/json"
      ]
    }
  ]
